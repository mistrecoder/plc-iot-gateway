PROGRAM main
  VAR
    bp_marche_1 : BOOL AT %IX0.0; (* Bouton Marche — Poste Local *)
    bp_arret_1 : BOOL AT %IX0.1; (* Bouton Arrêt — Poste Local *)
    bp_marche_2 : BOOL AT %IX0.2; (* Bouton Marche — Post Déporté *)
    bp_arret_2 : BOOL AT %IX0.3; (* Bouton Arrêt — Poste Déporté *)
    arret_urgence : BOOL AT %IX0.4; (* Arrêt d'Urgence Machine (E-Stop) *)
    moteur_convoyeur : BOOL AT %QX0.0; (* Commande puissance du tapis *)
    compteur_lot : CTU;
    capteur_piece : BOOL AT %IX0.5; (* Détecteur de passage pièce/carton *)
    bp_reset_lot : BOOL AT %IX0.6; (* Bouton réarmement compteur de lot *)
    voyant_lot_plein : BOOL AT %QX0.1; (* Indicateur "Lot 5 pièces complet" *)
    nb_pieces : INT;
    capteur_bourrage : BOOL AT %IX0.7; (* Détection bourrage convoyeur *)
    defaut_actif : BOOL;
    clk_on : TON; (* Demi-période niveau haut clignotant *)
    clk_off : TON; (* Demi-période niveau bas clignotant *)
    voyant_alarme : BOOL AT %QX0.2; (* Signalisation visuelle défaut *)
    sirene : BOOL AT %QX0.3; (* Avertisseur acoustique défaut *)
    bp_ack : BOOL AT %IX1.0; (* Bouton d'acquittement alarme *)
    acquitte : BOOL;
    flash : BOOL; (* Bit mémoire d'horloge 1 Hz *)
  END_VAR

