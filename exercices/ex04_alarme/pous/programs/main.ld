PROGRAM main
  VAR
    capteur_niveau : BOOL AT %IX0.0; (* Capteur de niveau haut du réservoir *)
    bp_acquit : BOOL AT %IX0.1; (* Bouton d'acquittement opérateur *)
    alarme_visuelle : BOOL AT %QX0.0; (* Voyant d'alarme (clignote ou fixe) *)
    sirene : BOOL AT %QX0.1; (* Sirène sonore *)
    acquitte : BOOL; (* Mémoire interne : alarme acquittée *)
    clk_on : TON; (* Timer pour phase ON du clignotement *)
    clk_off : TON; (* Timer pour phase OFF du clignotement *)
    flash : BOOL; (* Bit interne de clignotement *)
  END_VAR

