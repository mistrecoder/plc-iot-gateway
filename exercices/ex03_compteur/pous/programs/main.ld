PROGRAM main
  VAR
    capteur_piece : BOOL AT %IX0.0; (* Détecteur optique de passage de pièce *)
    bp_reset : BOOL AT %IX0.1; (* Bouton remise à zéro du lot *)
    bp_start : BOOL AT %IX0.2; (* Interrupteur Marche de la ligne *)
    convoyeur : BOOL AT %QX0.0; (* Moteur du convoyeur *)
    voyant_plein : BOOL AT %QX0.1; (* Voyant alerte carton plein *)
    compteur_lot : CTU; (* Instance du bloc compteur *)
    nb_pieces : INT; (* Variable contenant le compte actuel *)
  END_VAR

